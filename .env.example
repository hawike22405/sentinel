# Copy to .env (never commit .env). Real environment variables take precedence.
PORT=3000
NODE_ENV=production

# Set behind a TLS-terminating reverse proxy: trust exactly one proxy hop.
TRUST_PROXY=0
# Redirect all plain-HTTP requests to https://PUBLIC_HOST (needs TRUST_PROXY=1 behind a proxy).
FORCE_HTTPS=0
PUBLIC_HOST=

# Only needed if the frontend is served from a different origin. Leave empty for same-origin (CORS fully off).
FRONTEND_ORIGIN=

# Enables the moderation endpoint DELETE /api/admin/reports/:id. Min 32 chars; leave empty to disable it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Optional overrides
# SENTINEL_DATA_DIR=./data
# GENERAL_LIMIT=120
# STRICT_LIMIT=15


# Required for Vercel (hosted persistent libSQL/Turso database; server secrets only).
# When absent on a normal local run, the existing local SQLite database is used.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
